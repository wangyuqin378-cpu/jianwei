  "facts": [
    {
      "factId": "helmet-draft-002",
      "topicId": "helmet",
      "factText": "骑行头盔要水平、贴合地戴在头上，前沿约在眉毛上方一到两指宽处，并把下巴带系紧。",
      "sourceIds": ["src-cpsc-bicycle-helmet-fit", "src-cdc-bike-helmet-safety"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "helmet-draft-003",
      "topicId": "helmet",
      "factText": "头盔经历碰撞后，即使外观没有裂痕也应更换，因为内部缓冲层可能已经受损并降低保护能力。",
      "sourceIds": ["src-cpsc-bicycle-helmets-guidance", "src-cdc-bike-helmet-replacement"],
      "riskLevel": "safety",
