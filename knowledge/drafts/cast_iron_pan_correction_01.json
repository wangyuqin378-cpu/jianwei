    {
      "factId": "cast-iron-pan-001",
      "topicId": "cast_iron_pan",
      "factText": "铸铁锅质量大、热容量高，升温较慢，却能在放入食材后较好地维持表面温度。",
      "sourceIds": ["src-cookware"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "cast-iron-pan-draft-002",
      "topicId": "cast_iron_pan",
      "factText": "铸铁锅的“开锅层”是油脂受热后聚合并附着在铁表面形成的保护层，不是没有洗净的油污。",
      "sourceIds": ["src-usu-cast-iron-care"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "cast-iron-pan-draft-003",
      "topicId": "cast_iron_pan",
      "factText": "铸铁锅清洗后要彻底烘干，再薄薄擦一层食用油；残留水分会促进生锈，厚油层则容易发黏。",
      "sourceIds": ["src-usu-cast-iron-care"],
      "riskLevel": "general",
