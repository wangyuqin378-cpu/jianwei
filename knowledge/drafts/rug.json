  "facts": [
    {
      "factId": "rug-draft-001",
      "topicId": "rug",
      "factText": "簇绒地毯用针把纱线穿过第一层底布，在背面留下短线圈、正面形成绒面；第二层底布再覆盖背面，把线圈和底层固定成夹层。",
      "sourceIds": ["src-rug-tuft-primary-secondary-backing"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "rug-draft-002",
      "topicId": "rug",
      "factText": "地毯绒头可以是完整线圈，也可以把线圈切开形成割绒；有些聚酯结构通过加热让可熔底布软化，从背面锁住簇绒。",
      "sourceIds": ["src-rug-melt-bonded-tuft"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "rug-draft-003",
      "topicId": "rug",
      "factText": "块毯边缘容易露出底布，因此最外一排簇绒会用特殊针路向外挤开；绒毛尖端铺过底布切边后，就形成连续的绒面收口。",
      "sourceIds": ["src-rug-edge-tuft-finish"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    }
  ]
