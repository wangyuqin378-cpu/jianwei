  "facts": [
    {
      "factId": "pressure-cooker-draft-001",
      "topicId": "pressure_cooker",
      "factText": "压力锅密封后蒸汽使锅内压力和温度升高，从而加快烹饪；这也是它比普通锅更快的核心原理。",
      "sourceIds": ["src-usu-electric-pressure-cookers", "src-uf-ifas-pressure-cookers"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "pressure-cooker-draft-002",
      "topicId": "pressure_cooker",
      "factText": "锅盖难以打开通常表示内部仍有压力，必须等压力完全释放后再开盖，不能用力强行旋开。",
      "sourceIds": ["src-usu-electric-pressure-cookers", "src-cpsc-pressure-cooker-letter"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "pressure-cooker-draft-003",
      "topicId": "pressure_cooker",
      "factText": "汤、粥或淀粉类食物可能起泡并堵塞排气通道；装得过满或快速泄压会增加热液喷出的风险。",
      "sourceIds": ["src-usu-electric-pressure-cookers", "src-cpsc-pressure-cooker-letter"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    }
  ]
