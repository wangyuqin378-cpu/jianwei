      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "paint-brush-draft-002",
      "topicId": "paint_brush",
      "factText": "刷毛中间的间隔件既能留出储漆腔，也能把贯穿开口当作清洗流道，让水从手柄连接端进入刷毛深处再向外带走残留。",
      "sourceIds": ["src-paint-brush-cleaning-passage"],
