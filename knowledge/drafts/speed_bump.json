    {
      "factId": "speed-bump-draft-001",
      "topicId": "speed_bump",
      "factText": "减速丘通过让车辆经历可预期的垂直抬升来限制速度，通常需要沿路线成组布置，单独一处难以维持整段低速。",
      "sourceIds": ["src-uk-dft-traffic-calming-guidance", "src-hse-workplace-transport-speed"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "speed-bump-draft-002",
      "topicId": "speed_bump",
      "factText": "减速垫不像整幅减速丘那样横贯道路，而是采用较窄的局部凸起；其宽度、间距和轮迹关系属于设计的一部分。",
      "sourceIds": ["src-uk-dft-traffic-calming-guidance", "src-hse-workplace-transport-speed"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "speed-bump-draft-003",
      "topicId": "speed_bump",
      "factText": "减速设施本体应清晰标记，预警标志也要留出足够可见距离，让道路使用者能在到达凸起前识别并减速。",
      "sourceIds": ["src-uk-dft-traffic-calming-guidance", "src-hse-workplace-transport-speed"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    }
  ]
