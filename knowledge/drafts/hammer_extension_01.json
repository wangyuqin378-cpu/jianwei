      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "hammer-draft-003",
      "topicId": "hammer",
      "factText": "冲击工具的受击端出现蘑菇状卷边、裂口或缺口时，继续敲击可能飞出碎片，应先修整或停用并佩戴眼部防护。",
      "sourceIds": ["src-osha-hand-power-tools", "src-ccohs-hammers"],
