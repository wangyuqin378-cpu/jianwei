  "facts": [
    {
      "factId": "cutting-board-001",
      "topicId": "cutting_board",
      "factText": "砧板提供可牺牲的平整表面，既保护台面，也让刀刃承受比石材台面更温和的接触。",
      "sourceIds": ["src-cookware"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "cutting-board-draft-002",
      "topicId": "cutting_board",
      "factText": "处理生肉、禽肉或海鲜的砧板应与切水果、蔬菜和即食食物的砧板分开，减少交叉污染。",
      "sourceIds": ["src-foodsafety-gov-four-steps", "src-fda-safe-food-handling"],
      "riskLevel": "health",
      "reviewStatus": "draft"
    },
    {
      "factId": "cutting-board-draft-003",
      "topicId": "cutting_board",
      "factText": "砧板每次使用后都要用热肥皂水清洗；处理完一种食材后，应洗净再继续处理下一种食材。",
      "sourceIds": ["src-foodsafety-gov-four-steps", "src-fda-safe-food-handling"],
      "riskLevel": "health",
      "reviewStatus": "draft"
    }
