    {
      "factId": "fuel-nozzle-draft-001",
      "topicId": "fuel_nozzle",
      "factText": "自动跳枪依靠枪口附近的感应孔和文丘里负压工作；当油面封住感应气路，压力变化会触发机构关闭主阀。",
      "sourceIds": ["src-epa-stage-ii-nozzle-guidance", "src-opw-automatic-nozzle"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "fuel-nozzle-draft-002",
      "topicId": "fuel_nozzle",
      "factText": "真空辅助加油枪把油气通道和油液通道集成在枪体内，油液流动时联动油气阀，让逸出的汽油蒸气被系统抽回。",
      "sourceIds": ["src-epa-stage-ii-nozzle-guidance", "src-opw-12vw-vapor-nozzle"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "fuel-nozzle-draft-003",
      "topicId": "fuel_nozzle",
      "factText": "第二阶段油气回收系统会把加油时收集的汽油蒸气，经独立油气管路送回加油站储罐，减少蒸气直接逸散。",
      "sourceIds": ["src-epa-stage-ii-nozzle-guidance", "src-opw-cvs2-vapor-system"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    }
