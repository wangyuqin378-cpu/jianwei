      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "kitchen-knife-draft-002",
      "topicId": "kitchen_knife",
      "factText": "防粘刀面的凹槽可以从刀背一直向下延伸、在刀刃前结束；因为槽顶始终与空气相通，切片贴上刀面时不容易在封闭凹坑里形成完整吸附面。",
      "sourceIds": ["src-kitchen-knife-open-air-channels"],
      "riskLevel": "general",
