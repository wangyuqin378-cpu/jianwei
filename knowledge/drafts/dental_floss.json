  "facts": [
    {
      "factId": "dental-floss-draft-001",
      "topicId": "dental_floss",
      "factText": "牙刷毛很难有效进入紧密的牙缝；牙线等牙间清洁工具用于带走两牙之间和牙龈边缘的食物残屑与牙菌斑。",
      "sourceIds": ["src-ada-dental-floss", "src-nhs-toothbrush"],
      "riskLevel": "health",
      "reviewStatus": "draft"
    },
    {
      "factId": "dental-floss-draft-002",
      "topicId": "dental_floss",
      "factText": "牙线到达牙龈线后应贴着单颗牙弯成 C 形，再沿牙面轻柔上下移动；不要猛地把牙线弹入牙龈。",
      "sourceIds": ["src-nhs-toothbrush", "src-nidcr-oral-hygiene"],
      "riskLevel": "health",
      "reviewStatus": "draft"
    },
    {
      "factId": "dental-floss-draft-003",
      "topicId": "dental_floss",
      "factText": "牙线过去曾用多股丝纤维捻成；如今常见产品更多采用尼龙细丝或塑料单丝，是否上蜡并不是清洁效果的决定因素。",
      "sourceIds": ["src-ada-dental-floss"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    }
  ]
