  "facts": [
    {
      "factId": "mattress-draft-001",
      "topicId": "mattress",
      "factText": "独立袋弹簧把每只金属线圈单独装进布套；有些结构还把小块泡棉与弹簧封在同一布袋中，让每个单元同时承担弹性和缓冲。",
      "sourceIds": ["src-mattress-pocketed-coil-topper"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "mattress-draft-002",
      "topicId": "mattress",
      "factText": "床垫的软硬分区可以来自弹簧上方的缓冲层：把不同泡棉垫和长条分别排列在对应区域，就能形成不同的局部支撑结构。",
      "sourceIds": ["src-mattress-segmented-support-layer"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "mattress-draft-003",
      "topicId": "mattress",
      "factText": "床垫边缘常有独立加固圈；一种结构用泡棉边框包围内部弹簧，再把额外边缘弹簧插进泡棉开槽中，提高外围的结构刚度。",
      "sourceIds": ["src-mattress-edge-support"],
