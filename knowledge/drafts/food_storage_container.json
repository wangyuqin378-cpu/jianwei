  "facts": [
    {
      "factId": "food-storage-container-draft-001",
      "topicId": "food_storage_container",
      "factText": "手压真空保鲜盒可以把波纹泵直接做在盒盖上：反复按压时，两只单向阀依次控制进气和排气，把盒内空气泵出；另一只释放阀负责恢复内外压力。",
      "sourceIds": ["src-food-container-bellows-vacuum-lid"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "food-storage-container-draft-002",
      "topicId": "food_storage_container",
      "factText": "可堆叠真空盒会让盒底的环形凸起嵌入另一只盒盖的环形凹槽；盒盖中的伞形硅胶片只允许抽气方向弯起，反向则贴回阀座。",
      "sourceIds": ["src-food-container-stacking-umbrella-valve"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "food-storage-container-draft-003",
      "topicId": "food_storage_container",
      "factText": "有些真空盒盖用一枚可变形的凸点显示内部压力：抽气后凸点被压低；当盒内真空明显减弱时，它会改变位置，让用户不用开盖就能观察状态。",
      "sourceIds": ["src-food-container-vacuum-indicator"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    }
