  "facts": [
    {
      "factId": "hair-dryer-draft-001",
      "topicId": "hair_dryer",
      "factText": "吹风机插头上的测试和复位按钮属于漏电保护装置；检测到异常漏电时会在极短时间内切断电源。",
      "sourceIds": ["src-cpsc-hair-dryer-faq", "src-ul-hair-dryer-alci"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "hair-dryer-draft-002",
      "topicId": "hair_dryer",
      "factText": "即使开关处于关闭位置，插着电的吹风机落入水中仍可能使水带电，因此不应在浴缸或水槽旁使用。",
      "sourceIds": ["src-cpsc-hair-dryer-safety", "src-ul-hair-dryer-alci"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "hair-dryer-draft-003",
      "topicId": "hair_dryer",
      "factText": "吹风机若落入水中，不要先伸手拿取，应先拔掉插头再移开；停用时也应拔下电源并远离水槽、浴缸。",
      "sourceIds": ["src-cpsc-hair-dryer-safety", "src-ul-hair-dryer-alci"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    }
  ]
