    },
    {
      "factId": "rice-paddle-draft-002",
      "topicId": "rice_paddle",
      "factText": "饭勺表面的密集小凸点会把米饭与勺面的连续接触拆成许多小区域；相关设计还利用凸点帮助拨散黏在一起的米粒。",
      "sourceIds": ["src-rice-paddle-surface-bumps"],
