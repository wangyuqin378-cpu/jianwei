  "facts": [
    {
      "factId": "bicycle-chain-draft-001",
      "topicId": "bicycle_chain",
      "factText": "自行车链条由内链板与外链板交替组成，销轴把相邻链节连接起来，滚子套在内链节的圆筒或套管外侧。",
      "sourceIds": ["src-bicycle-chain-link-structure"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "bicycle-chain-draft-002",
      "topicId": "bicycle_chain",
      "factText": "有的链条用可拆主链节连接两端；内链板外表面的轮廓和间距还会针对换挡时与飞轮齿片的接触进行设计。",
      "sourceIds": ["src-bicycle-chain-master-link-profile"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "bicycle-chain-draft-003",
      "topicId": "bicycle_chain",
      "factText": "为了让链条更顺利地从大齿片移向小齿片，内链板靠滚子一侧的凸出量可以减小，给相邻链节留下更多偏转空间。",
      "sourceIds": ["src-bicycle-chain-shifting-protrusion"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    }
  ]
