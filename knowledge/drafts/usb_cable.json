    {
      "factId": "usb-cable-draft-002",
      "topicId": "usb_cable",
      "factText": "外形同为 Type-C 的线材，数据速率和供电能力也可能不同；USB Type-C 并不是 USB 3.2、USB4 或 USB PD 的同义词。",
      "sourceIds": ["src-usb-if-type-c-guidelines"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "usb-cable-draft-003",
