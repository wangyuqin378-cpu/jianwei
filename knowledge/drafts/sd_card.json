  "facts": [
    {
      "factId": "sd-card-draft-001",
      "topicId": "sd_card",
      "factText": "SD、SDHC、SDXC和SDUC并不只是营销名称，它们对应不同容量区间：上限依次为2 GB、32 GB、2 TB和128 TB。",
      "sourceIds": ["src-sd-capacity-standards"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "sd-card-draft-002",
      "topicId": "sd_card",
      "factText": "这些容量标准还规定默认文件系统：SD使用FAT12或FAT16，SDHC使用FAT32，而SDXC和SDUC使用exFAT。",
      "sourceIds": ["src-sd-capacity-standards"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "sd-card-draft-003",
      "topicId": "sd_card",
      "factText": "SD卡兼容性通常由主机代际决定：较新的SDUC主机可使用更早的SD、SDHC和SDXC卡，但旧SD主机不能反向识别SDHC、SDXC或SDUC卡。",
      "sourceIds": ["src-sd-compatibility"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    }
  ]
