  "facts": [
    {
      "factId": "car-tire-draft-001",
      "topicId": "car_tire",
      "factText": "轮胎压力应至少每月检查一次，并在停车三小时以上的冷胎状态测量；备胎也要一起检查。",
      "sourceIds": ["src-aaa-be-tire-smart", "src-ustma-tire-care-essentials"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "car-tire-draft-002",
      "topicId": "car_tire",
      "factText": "正确胎压应查驾驶员侧车门标签或车辆手册，并按车辆制造商给出的数值充气，不能只凭轮胎外观判断。",
      "sourceIds": ["src-aaa-be-tire-smart", "src-ustma-tire-care-essentials"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "car-tire-draft-003",
      "topicId": "car_tire",
      "factText": "轮胎花纹磨到与内置磨耗标记齐平时应更换；每月还应查看是否有割伤、鼓包或异常磨损。",
      "sourceIds": ["src-aaa-be-tire-smart", "src-ustma-tire-care-essentials"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    }
  ]
