  "facts": [
    {
      "factId": "storage-box-draft-001",
      "topicId": "storage_box",
      "factText": "许多塑料收纳箱的侧壁会向箱底略微收窄。这不是造型偶然：空箱能一个套进另一个，带铰链的箱盖则可向外翻开后交错叠放。",
      "sourceIds": ["src-storage-box-nesting-taper"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "storage-box-draft-002",
      "topicId": "storage_box",
      "factText": "布艺折叠收纳箱并非只有软布：前后片可藏整块硬板，左右片各藏两块硬板，中间折线让侧壁对折，展开时又能撑成方形。",
      "sourceIds": ["src-storage-box-folding-panels"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "storage-box-draft-003",
      "topicId": "storage_box",
      "factText": "折叠箱的盖子有时也是结构件：盖内圈压住上框和侧壁锁片，可同时限制两侧向内或向外摆动，让展开后的箱体更稳定。",
      "sourceIds": ["src-storage-box-lid-bracing"],
