  "facts": [
    {
      "factId": "electrical-outlet-draft-001",
      "topicId": "electrical_outlet",
      "factText": "带测试和复位按钮的 GFCI 插座会比较流入与返回电流，检测到漏电差值时迅速切断回路。",
      "sourceIds": ["src-cpsc-gfci-fact-sheet", "src-esfi-gfci"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "electrical-outlet-draft-002",
      "topicId": "electrical_outlet",
      "factText": "GFCI 常用于可能接触水的区域，但保护装置也需要每月测试，不能把按钮存在当作一直有效。",
      "sourceIds": ["src-cpsc-home-electrical-checklist", "src-esfi-gfci"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "electrical-outlet-draft-003",
      "topicId": "electrical_outlet",
      "factText": "测试时可接入小灯并按下测试键；若不断电，或按复位键后不能恢复，应停用并请专业人员处理。",
      "sourceIds": ["src-cpsc-home-electrical-checklist", "src-esfi-gfci"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    }
  ]
