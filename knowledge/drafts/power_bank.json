  "facts": [
    {
      "factId": "power-bank-draft-001",
      "topicId": "power_bank",
      "factText": "民航规则把充电宝视为备用锂电池，乘机时必须放入随身行李，不能托运；登机口托运行李前也要取出。",
      "sourceIds": ["src-caac-power-bank-rules", "src-caac-power-bank-rules-restated"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "power-bank-draft-002",
      "topicId": "power_bank",
      "factText": "额定能量不超过一百瓦时的充电宝通常可随身携带；超过一百但不超过一百六十瓦时需先获航司批准。",
      "sourceIds": ["src-caac-power-bank-rules", "src-caac-power-bank-rules-restated"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    },
    {
      "factId": "power-bank-draft-003",
      "topicId": "power_bank",
      "factText": "乘坐境内航班时，没有或看不清 3C 标识，以及属于被召回型号或批次的充电宝，都不能带上飞机。",
      "sourceIds": ["src-caac-power-bank-ccc-rule", "src-caac-east-power-bank-ccc"],
      "riskLevel": "safety",
      "reviewStatus": "draft"
    }
  ]
