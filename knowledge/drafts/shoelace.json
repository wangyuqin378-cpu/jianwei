    {
      "factId": "shoelace-draft-001",
      "topicId": "shoelace",
      "factText": "鞋带末端的硬头叫 aglet。把它做成逐渐收尖的弧形，能让尖端更容易对准鞋孔，并在拉动时顺着孔壁转向。",
      "sourceIds": ["src-shoelace-curved-aglet"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "shoelace-draft-002",
      "topicId": "shoelace",
      "factText": "弹性鞋带可以由弹性内芯和编织外套组成；再把细长摩擦条织进外套并略微凸出，就能在鞋孔和打结处增加接触。",
      "sourceIds": ["src-shoelace-elastic-core"],
      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "shoelace-draft-003",
      "topicId": "shoelace",
      "factText": "有些可调鞋带利用“拉伸会变细”：拉紧时鞋带直径缩小，鞋带头可沿线移动；松开后直径恢复，鞋带头便被卡住。",
      "sourceIds": ["src-shoelace-adjustable-aglet"],
