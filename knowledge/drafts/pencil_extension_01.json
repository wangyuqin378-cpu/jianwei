      "riskLevel": "general",
      "reviewStatus": "draft"
    },
    {
      "factId": "pencil-draft-003",
      "topicId": "pencil",
      "factText": "铅笔标号里的 H 表示硬、B 表示黑；H 前数字越大通常越硬，B 前数字越大通常越软、颜色越深，HB 位于中间。",
      "sourceIds": ["src-staedtler-pencil-guide"],
