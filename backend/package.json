{
  "name": "@jianwei/backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "experience:free": "tsx src/start-free-experience.ts",
    "migrate": "tsx src/migrate.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "e2e": "node ../scripts/run-backend-e2e.mjs",
    "e2e:self-test": "node ../scripts/run-backend-e2e.mjs --self-test",
    "export:card-audit": "tsx src/export-card-audit-snapshots.ts",
    "issue:evaluation-lease": "tsx src/issue-evaluation-lease.ts",
    "revoke:evaluation-lease": "tsx src/revoke-evaluation-lease.ts",
    "verify:cloud-beta": "tsx src/verify-cloud-beta.ts",
    "verify:qwen-guardrail-access": "tsx src/verify-qwen-guardrail-access.ts",
    "verify:qwen-provider": "tsx src/verify-qwen-provider.ts",
    "review:knowledge-ai": "tsx src/review-knowledge-ai.ts",
    "release:identity": "tsx src/release-identity.ts",
    "test": "vitest run --coverage.enabled=false",
    "test:postgres": "vitest run src/postgres.integration.test.ts --coverage.enabled=false"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@fastify/cors": "10.1.0",
    "@fastify/rate-limit": "10.3.0",
    "ali-oss": "6.23.0",
    "fastify": "5.10.0",
    "postgres": "3.4.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.3",
    "@types/node": "26.3.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
