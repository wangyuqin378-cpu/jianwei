HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
DATABASE_URL=
OBJECT_STORE=local
LOCAL_OBJECT_DIR=.data/objects
VISION_PROVIDER=local
# Qwen production requests require Alibaba Cloud Model Studio AI Guardrails to be
# activated for this workspace, including its service-linked-role authorization.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_FLASH_MODEL=qwen3.6-flash-2026-04-16
QWEN_PLUS_MODEL=qwen3.6-plus-2026-04-02

# Managed iOS subscription verification. Production requires Apple's DER root
# certificates mounted read-only and listed as comma-separated absolute paths.
APP_STORE_BUNDLE_ID=cn.jianwei.ios
APP_STORE_APP_APPLE_ID=
APP_STORE_SUBSCRIPTION_PRODUCT_ID=cn.jianwei.ios.pro.monthly
APP_STORE_ENVIRONMENT=sandbox
APP_STORE_ROOT_CERTIFICATE_PATHS=
# Production Kimi must use https://api.moonshot.cn/v1 with an Open Platform key.
# https://api.kimi.com/coding/v1 and model k3 are accepted only for local engineering validation.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
OSS_REGION=oss-cn-beijing
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
MAX_JOBS_PER_DEVICE_PER_DAY=3
MAX_JOBS_PER_DEVICE_PER_MONTH=93
MAX_JOBS_GLOBAL_PER_DAY=2000
MAX_JOBS_GLOBAL_PER_MONTH=50000
# One CNY is 1,000,000 micro-CNY. These values are mandatory for every cloud provider.
# Reserve a deployment-reviewed worst-case (recognition + optional fallback + card writer) before every job.
WORST_CASE_COST_MICRO_CNY_PER_JOB=1000000
MAX_GLOBAL_COST_MICRO_CNY_PER_DAY=2000000000
MAX_GLOBAL_COST_MICRO_CNY_PER_MONTH=50000000000
OBJECT_TTL_HOURS=24
ALLOW_UNATTESTED_FACTS=true
# Required in production. Obtain this from the pushed registry manifest, never from a mutable tag.
CONTAINER_IMAGE_DIGEST=
