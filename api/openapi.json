{
  "openapi": "3.1.0",
  "info": {
    "title": "见微 API",
    "version": "1.0.0",
    "description": "Anonymous device API for privacy-filtered photo analysis and reviewed knowledge cards."
  },
  "servers": [{ "url": "https://api.example.invalid" }],
  "paths": {
    "/health": {
      "get": { "operationId": "readinessAlias", "responses": { "200": { "description": "Ready" }, "503": { "description": "Not ready" } } }
    },
    "/health/ready": {
      "get": { "operationId": "readiness", "responses": { "200": { "description": "Ready" }, "503": { "description": "Not ready" } } }
    },
    "/health/live": {
      "get": { "operationId": "liveness", "responses": { "200": { "description": "Live" } } }
    },
    "/v1/devices/register": {
      "post": {
        "operationId": "registerDevice",
        "x-android-client": "retrofit",
        "x-android-request-model": "RegisterRequest",
        "x-android-response-model": "RegisterResponse",
        "x-backend-zod-schema": "registerDeviceSchema",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } } },
        "responses": { "201": { "description": "Registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterResponse" } } } }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/analysis-jobs": {
      "post": {
        "operationId": "createAnalysisJob",
        "x-android-client": "retrofit",
        "x-android-request-model": "CreateJobRequest",
        "x-android-response-model": "CreateJobResponse",
        "x-backend-zod-schema": "createAnalysisJobSchema",
        "security": [{ "deviceBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/EvaluationLease" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateJobRequest" } } } },
        "responses": { "201": { "description": "Created or reused", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateJobResponse" } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "410": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/analysis-jobs/{id}/image": {
      "put": {
        "operationId": "uploadAnalysisImage",
        "x-android-client": "raw",
        "security": [{ "deviceBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "required": true, "content": { "image/jpeg": { "schema": { "type": "string", "contentEncoding": "binary" } } } },
        "responses": { "200": { "description": "Uploaded" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "410": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/analysis-jobs/{id}/complete": {
      "post": {
        "operationId": "completeAnalysisJob",
        "x-android-client": "retrofit",
        "x-android-response-model": "CompleteJobResponse",
        "security": [{ "deviceBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "200": { "description": "Completed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompleteJobResponse" } } } }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/analysis-jobs/{id}": {
      "get": {
        "operationId": "getAnalysisJob",
        "security": [{ "deviceBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "200": { "description": "Job status" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/cards": {
      "get": {
        "operationId": "listCards",
        "x-android-client": "retrofit",
        "x-android-response-model": "CardsResponse",
        "security": [{ "deviceBearer": [] }],
        "parameters": [
          { "name": "cursor", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 } }
        ],
        "responses": { "200": { "description": "Cards", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CardsResponse" } } } }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/cards/{id}/feedback": {
      "post": {
        "operationId": "sendFeedback",
        "x-android-client": "retrofit",
        "x-android-request-model": "FeedbackRequest",
        "x-android-response-model": "FeedbackResponse",
        "x-backend-zod-schema": "feedbackSchema",
        "security": [{ "deviceBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeedbackRequest" } } } },
        "responses": { "201": { "description": "Recorded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeedbackResponse" } } } }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/items/{cardId}/track": {
      "post": {
        "operationId": "trackItem",
        "x-android-client": "retrofit",
        "x-android-request-model": "TrackRequest",
        "x-backend-zod-schema": "trackItemSchema",
        "security": [{ "deviceBearer": [] }],
        "parameters": [{ "name": "cardId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TrackRequest" } } } },
        "responses": { "201": { "description": "Tracked" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "operationId": "cancelTrackedItem",
        "x-android-client": "retrofit",
        "security": [{ "deviceBearer": [] }],
        "parameters": [{ "name": "cardId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "204": { "description": "Tracking cancelled or already absent" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/device-data": {
      "delete": {
        "operationId": "deleteDeviceData",
        "x-android-client": "retrofit",
        "security": [{ "deviceBearer": [] }],
        "responses": { "204": { "description": "Deleted" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "deviceBearer": { "type": "http", "scheme": "bearer" } },
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "EvaluationLease": {
        "name": "X-Jianwei-Evaluation-Lease",
        "in": "header",
        "required": false,
        "description": "Short-lived bounded bearer for the Debug-only authorized evaluation runner; must be supplied with evaluationContext.",
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    },
    "responses": { "Error": { "description": "Structured API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } },
    "schemas": {
      "RegisterRequest": { "type": "object", "additionalProperties": false, "required": ["installationId"], "properties": { "installationId": { "type": "string", "format": "uuid" } } },
      "RegisterResponse": { "type": "object", "additionalProperties": false, "required": ["deviceId", "deviceToken", "created"], "properties": { "deviceId": { "type": "string", "format": "uuid" }, "deviceToken": { "type": "string" }, "created": { "type": "boolean" } } },
      "CreateJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateToken", "localLabels", "qualityScore", "sensitiveFlags", "contentType"],
        "properties": {
          "candidateToken": { "type": "string", "format": "uuid" },
          "capturedAtBucket": { "type": ["string", "null"], "format": "date" },
          "localLabels": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 80 } },
          "qualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "sensitiveFlags": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 80 } },
          "contentType": { "const": "image/jpeg" },
          "evaluationContext": { "$ref": "#/components/schemas/EvaluationContextRequest" }
        }
      },
      "EvaluationContextRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["datasetId", "runId", "labelsSha256", "sampleId"],
        "properties": {
          "datasetId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{3,128}$" },
          "runId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{3,128}$" },
          "labelsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sampleId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{3,128}$" }
        }
      },
      "CreateJobResponse": { "type": "object", "required": ["jobId", "status", "uploadUrl", "expiresAt"], "properties": { "jobId": { "type": "string", "format": "uuid" }, "status": { "type": "string" }, "uploadUrl": { "type": "string", "format": "uri" }, "expiresAt": { "type": "string", "format": "date-time" } } },
      "CompleteJobResponse": { "type": "object", "required": ["jobId", "status", "card"], "properties": { "jobId": { "type": "string", "format": "uuid" }, "status": { "type": "string" }, "card": { "oneOf": [{ "$ref": "#/components/schemas/Card" }, { "type": "null" }] } } },
      "CardsResponse": { "type": "object", "required": ["items", "nextCursor"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Card" } }, "nextCursor": { "type": ["string", "null"], "format": "uuid" } } },
      "FeedbackRequest": { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "type": "string", "enum": ["LIKE", "DISLIKE", "WRONG_OBJECT", "TOO_PRIVATE", "SAVE"] } } },
      "FeedbackResponse": { "type": "object", "additionalProperties": false, "required": ["id", "cardId", "action", "createdAt", "topicAffinities"], "properties": { "id": { "type": "string", "format": "uuid" }, "cardId": { "type": "string", "format": "uuid" }, "action": { "type": "string", "enum": ["LIKE", "DISLIKE", "WRONG_OBJECT", "TOO_PRIVATE", "SAVE"] }, "createdAt": { "type": "string", "format": "date-time" }, "topicAffinities": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/components/schemas/TopicAffinity" } } } },
      "TrackRequest": { "type": "object", "additionalProperties": false, "required": ["startedOn", "reminderDays"], "properties": { "startedOn": { "type": "string", "format": "date" }, "reminderDays": { "type": "integer", "minimum": 7, "maximum": 730 } } },
      "TopicAffinity": { "type": "object", "additionalProperties": false, "required": ["topicId", "weight", "aliases"], "properties": { "topicId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" }, "weight": { "type": "number", "minimum": -2, "maximum": 2 }, "aliases": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 2, "maxLength": 48 } } } },
      "Source": { "type": "object", "additionalProperties": false, "required": ["sourceId", "title", "url", "publisher", "authority"], "properties": { "sourceId": { "type": "string", "minLength": 1, "maxLength": 100 }, "title": { "type": "string", "minLength": 1, "maxLength": 200 }, "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://" }, "publisher": { "type": "string", "minLength": 1, "maxLength": 120 }, "authority": { "type": "string", "enum": ["reference", "official", "professional"] } } },
      "Card": {
        "type": "object",
        "required": ["cardId", "candidateToken", "topicId", "factId", "title", "detectedObjectName", "body", "personalContext", "confidence", "sources", "status", "scheduledDate", "createdAt"],
        "properties": {
          "cardId": { "type": "string", "format": "uuid" }, "candidateToken": { "type": "string", "format": "uuid" }, "topicId": { "type": "string" }, "factId": { "type": "string" }, "title": { "type": "string" }, "detectedObjectName": { "type": "string", "minLength": 1, "maxLength": 60 }, "body": { "type": "string" }, "personalContext": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "sources": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/components/schemas/Source" } }, "status": { "type": "string" }, "scheduledDate": { "type": "string", "format": "date" }, "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } } }
    }
  }
}
