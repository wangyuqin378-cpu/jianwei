<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_preview_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_brand"
        android:textColor="#547765"
        android:textSize="10sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_preview_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="6dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_preview_image_description"
        android:scaleType="centerCrop"
        android:src="@drawable/onboarding_broom_example" />

    <TextView
        android:id="@+id/widget_preview_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_preview_title"
        android:textColor="#173F2E"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_preview_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="@string/widget_preview_body"
        android:textColor="#385C4A"
        android:textSize="11sp" />
</LinearLayout>
